{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ev-church-rock-image-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-18",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "www.ev.church/GetImage*",
      "zone_name": "ev.church"
    },
    {
      "pattern": "www.ev.church/GetAvatar*",
      "zone_name": "ev.church"
    }
  ]
}
