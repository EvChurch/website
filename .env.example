# Copy this file to .env.local for local development; .env.local is git-ignored.
# Configure the corresponding production values in Railway rather than committing secrets.

# Database (Railway PostgreSQL)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Payload CMS
# Generate with: openssl rand -base64 32
# Minimum 32 characters, cryptographically random
PAYLOAD_SECRET=CHANGE-ME-GENERATE-WITH-OPENSSL-RAND

# Site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Single Auth0 application for Payload admin and public-member sign-in
# Generate AUTH0_SECRET with: openssl rand -hex 32
AUTH0_DOMAIN=your-tenant.au.auth0.com
AUTH0_SECRET=CHANGE-ME-GENERATE-WITH-OPENSSL-RAND-HEX-32
APP_BASE_URL=http://localhost:3000
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# S3-Compatible Storage (Railway Object Storage)
S3_BUCKET=evchurch-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_ENDPOINT=

# Rock RMS API (shared by sync, forms, and member profile reads)
ROCK_API_URL=https://rock.ev.church/api
ROCK_API_KEY=
API_BIBLE_KEY=

# Cloudflare Turnstile. The site key is public; all other values are server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=www.ev.church

# Rock Connection Signup request protection
# Generate each secret independently. Context format: current-id:BASE64_SECRET
ROCK_CONNECTION_CONTEXT_KEYS=
ROCK_CONNECTION_RATE_LIMIT_SECRET=
# Enable only after the Railway origin is locked to Cloudflare.
ROCK_CONNECTION_TRUST_CF_CONNECTING_IP=false
# Optional tighter limits; the application caps these at 10 starts and 5 submits.
# ROCK_CONNECTION_START_RATE_LIMIT=10
# ROCK_CONNECTION_SUBMIT_RATE_LIMIT=5
# ROCK_PERSON_SEARCH_RATE_LIMIT=30

# Optional comma-separated exact HTTPS origins for existing Workflow redirects.
ROCK_WORKFLOW_REDIRECT_ORIGINS=

# Rock Webhook Security
# Shared secret for HMAC-SHA256 webhook validation
ROCK_WEBHOOK_SECRET=

# Preview Mode
# Generate with: openssl rand -base64 32
PREVIEW_SECRET=

# Cron Sync Trigger
# Protects the /api/sync/trigger endpoint
CRON_SECRET=

# Google Maps Embed API (browser-visible; restrict the key to this API and site domains)
GOOGLE_MAPS_API_KEY=

# Google Analytics
# Keep the existing GA4 web-stream ID during the old-site/new-site comparison period.
# This browser-visible measurement ID is not an account credential.
NEXT_PUBLIC_GA_ID=G-1R09W3HMNX

# PostHog Cloud (product analytics and public-page session replay)
# Account setup required first:
# 1. Create a PostHog Cloud project at https://app.posthog.com/signup.
# 2. In PostHog, open Project settings and copy the Project token.
# 3. Use the managed reverse proxy https://t.ev.church as the ingestion host.
# 4. Use https://us.posthog.com as the UI host for this US Cloud project.
# 5. Copy all three values to .env.local for local development and to Railway for production.
# The project token and hosts are browser-visible identifiers, not administrative API keys.
# Never put a PostHog personal API key in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://t.ev.church
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com

# Better Stack Rock reconciliation heartbeat
# Account setup required first:
# 1. In Better Stack, open Uptime -> Heartbeats and create a Rock sync heartbeat.
# 2. Expect it every 15 minutes with an appropriate grace period.
# 3. Copy its unique secret URL below. Never expose it client-side.
# This one reconciliation includes daily Bible readings; do not create a second heartbeat.
BETTER_STACK_ROCK_SYNC_HEARTBEAT_URL=

# Better Stack uptime monitoring needs no application credential.
# Create an HTTPS monitor in Better Stack for the deployed site's /api/health route;
# alert routing, escalation, and the public status page are configured in Better Stack.
