# syntax=docker/dockerfile:1
# Dedicated Rock Sync image. No Next prerendering or build database is used.
FROM node:24.22.3-bookworm-slim@sha256:dc26ae92c9fb15cf6b1d63e20f0944b2efe0f115b20e00be48fb23fceb061c54
COPY scripts/update-security-ca.sh /usr/local/bin/update-security-ca
RUN sh /usr/local/bin/update-security-ca \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global pnpm@12.14.0
ENV SSL_CERT_DIR=/usr/local/share/security-ca/certs NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY workers/rock-image-proxy/package.json workers/rock-image-proxy/package.json
COPY patches/ patches/
RUN pnpm install --frozen-lockfile
COPY . .
RUN S3_BUCKET=synthetic-ci-typecheck S3_ENDPOINT=http://127.0.0.1:57151 \
    DATABASE_URL=postgresql://build:build@127.0.0.1:1/build \
    pnpm run generate:types
ENV NODE_ENV=production
CMD ["npm", "run", "sync:rock"]
